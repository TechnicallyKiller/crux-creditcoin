{
  "name": "crux",
  "private": true,
  "version": "0.0.0",
  "description": "CRUX — attestation-settled prediction markets on Creditcoin",
  "type": "module",
  "workspaces": [
    "packages/*",
    "worker",
    "ai",
    "indexer",
    "web"
  ],
  "scripts": {
    "liveness": "node --experimental-strip-types scripts/check-liveness.ts",
    "prove": "node --experimental-strip-types scripts/prove-tx.ts",
    "build:contracts": "forge build --root contracts",
    "test:contracts": "forge test --root contracts -vv",
    "check:abi": "node --experimental-strip-types scripts/check-abi.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "^0.18.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0"
  }
}
